<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd 配置模板（由 scripts/install.sh 渲染，一般不需要手工编辑）

  占位符:
    __PYTHON__       虚拟环境里的 python 解释器绝对路径
    __SCRIPT__       scripts/bpx1_daemon.py 的绝对路径
    __LOG__          launchd 捕获的 stdout/stderr（只用来接异常栈）
    __ENVIRONMENT__  EnvironmentVariables 段（安装脚本按 BPX1_* 环境变量生成）

  说明:
    - 日常日志由守护进程自己写 out/daemon.log（按 5MB 轮转，保留 3 份），
      这里只兜底崩溃栈，正常运行时基本是空的；
    - KeepAlive 用 SuccessfulExit=false：只在异常退出时重启，
      正常退出（比如手动 bootout）不会被反复拉起；
    - 配置缺失（bindkey/MAC/iCloud）时守护进程不会退出，而是打 ERROR 日志
      并每 5 分钟重试，所以不会出现"10 秒重启一次"的风暴。

  常用命令:
    launchctl print gui/$(id -u)/com.mijia.bpx1scan     # 看状态
    launchctl kickstart -k gui/$(id -u)/com.mijia.bpx1scan  # 重启
    launchctl bootout gui/$(id -u)/com.mijia.bpx1scan   # 停止
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mijia.bpx1scan</string>

    <key>ProgramArguments</key>
    <array>
        <string>__PYTHON__</string>
        <string>-u</string>
        <string>__SCRIPT__</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>ProcessType</key>
    <string>Background</string>

    <key>StandardOutPath</key>
    <string>__LOG__</string>
    <key>StandardErrorPath</key>
    <string>__LOG__</string>

    <!-- 由 scripts/install.sh 按 BPX1_MAC / BPX1_INBOX 等环境变量替换 -->
__ENVIRONMENT__
</dict>
</plist>
